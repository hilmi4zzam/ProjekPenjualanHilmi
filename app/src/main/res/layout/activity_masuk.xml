<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Masuk"
    android:background="@color/background"
    android:id="@+id/main">

    <ScrollView
        android:layout_width="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="100dp"
                android:layout_marginTop="50dp"
                android:id="@+id/logoMasuk"
                android:layout_marginBottom="50dp"
                android:layout_height="100dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cvMasuk"
                android:src="@drawable/logosatset"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="300dp"
                android:id="@+id/cvMasuk"
                app:cardCornerRadius="40dp"
                android:background="@color/background"
                android:layout_height="wrap_content"
                android:layout_marginBottom="50dp"
                app:strokeColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/logoMasuk"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masuk"
                        android:id="@+id/tvMasuk"
                        android:textColor="@color/black"
                        android:textSize="40sp"
                        android:layout_marginTop="30dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tilModMasuk"
                        android:fontFamily="@font/alata"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilModMasuk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginHorizontal="25dp"
                        app:boxCornerRadiusBottomEnd="23dp"
                        app:boxCornerRadiusTopStart="23dp"
                        android:layout_marginTop="20dp"
                        app:boxCornerRadiusBottomStart="23dp"
                        app:boxCornerRadiusTopEnd="23dp"
                        android:textColorHint="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/tvMasuk"
                        android:hint="Nama Pengguna">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tietMasuk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/alata"
                            android:textColor="@color/black"
                            android:textSize="20sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilModMasukPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginHorizontal="25dp"
                        app:boxCornerRadiusBottomEnd="23dp"
                        app:boxCornerRadiusTopStart="23dp"
                        app:boxCornerRadiusBottomStart="23dp"
                        app:boxCornerRadiusTopEnd="23dp"
                        android:layout_marginTop="20dp"
                        android:textColorHint="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/tilModMasuk"
                        android:hint="Kata Sandi">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:id="@+id/tietMasukPassword"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/alata"
                            android:textSize="20sp"
                            android:inputType="textPassword"
                            android:layout_marginBottom="20dp"
                            android:textColor="@color/black"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:id="@+id/btnLanjutkan"
                        app:layout_constraintTop_toBottomOf="@id/tilModMasukPassword"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:text="Masuk"
                        android:layout_marginHorizontal="25dp"
                        android:backgroundTint="#FFB200"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="23dp"
                        android:layout_marginBottom="30dp"
                        android:fontFamily="@font/alata"
                        android:textSize="20sp"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>