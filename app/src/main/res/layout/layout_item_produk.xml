<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="30dp"
    app:cardCornerRadius="23dp"
    android:layout_marginEnd="30dp"
    android:layout_marginVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="60dp"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/logoitemproduk"
            android:layout_height="60dp"
            app:cardCornerRadius="15dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/img_14"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Kue Lumpur"
            android:id="@+id/tvItemProduk"
            android:textSize="20sp"
            android:fontFamily="@font/alata"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/logoitemproduk"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="12dp"/>

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="20.000"
            android:id="@+id/tvHargaProduk"
            android:textSize="20sp"
            android:fontFamily="@font/alata"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/logoitemproduk"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="12dp"/>


        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:id="@+id/logoKategoriProduk"
            android:background="@drawable/img_9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoitemproduk"
            android:layout_marginTop="9dp"/>

        <TextView
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:text="Makanan"
            android:id="@+id/tvKategoriProduk"
            android:textSize="15sp"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/alata"
            android:textColor="#807E7E"

            app:layout_constraintStart_toEndOf="@id/logoKategoriProduk"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:id="@+id/logoStokProduk"
            android:background="@drawable/img_10"
            app:layout_constraintStart_toEndOf="@id/tvKategoriProduk"
            app:layout_constraintTop_toTopOf="@id/logoKategoriProduk"
            android:layout_marginStart="7dp"/>

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="9.999"
            android:id="@+id/tvStokProduk"
            android:textSize="15sp"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/alata"
            android:textColor="#807E7E"
            app:layout_constraintStart_toEndOf="@id/logoStokProduk"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:id="@+id/logoCabangProduk"
            android:background="@drawable/img_5"
            app:layout_constraintStart_toEndOf="@id/tvStokProduk"
            app:layout_constraintTop_toTopOf="@id/logoKategoriProduk"/>

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Surakarta"
            android:id="@+id/tvCabangProduk"
            android:textSize="15sp"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/alata"
            android:textColor="#807E7E"
            app:layout_constraintStart_toEndOf="@id/logoCabangProduk"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAktif"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Aktif"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="20sp"
            app:chipIcon="@drawable/lingkaran_online"
            app:chipIconSize="10dp"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#D0D0D0"
            app:chipCornerRadius="23dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>