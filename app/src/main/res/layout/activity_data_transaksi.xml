<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".transaksi.DataTransaksi">

    <com.google.android.material.card.MaterialCardView
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="23dp"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/searchDataProduk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.SearchView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:iconifiedByDefault="false"
            app:queryHint="Cari sesuatu di sini..."
            app:queryBackground="@android:color/transparent"
            app:searchIcon="@drawable/img_8" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/selectKategori"
        android:layout_width="match_parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="15dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/searchDataProduk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="#FFB200"
            app:cardCornerRadius="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Semua"
                android:textSize="20sp"
                android:fontFamily="@font/alata"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="#B06710"
            app:cardCornerRadius="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Makanan"
                android:textSize="20sp"
                android:fontFamily="@font/alata"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="#B06710"
            app:cardCornerRadius="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Minuman"
                android:textSize="20sp"
                android:fontFamily="@font/alata"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="#B06710"
            app:cardCornerRadius="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Snack"
                android:textSize="20sp"
                android:fontFamily="@font/alata"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/selectKategori"
        android:id="@+id/rvDataProduk"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/layout_item_produk"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/black">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height=""

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>