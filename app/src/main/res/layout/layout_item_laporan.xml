<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="30dp"
    app:cardCornerRadius="23dp"
    android:layout_marginEnd="30dp"
    android:layout_marginVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="50dp"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/logoitemlaporan"
            android:layout_height="50dp"
            app:cardCornerRadius="15dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:strokeWidth="0dp"
            android:backgroundTint="#b36f32">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/img_1"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Hilmi"
            android:id="@+id/tvItemProduk"
            android:textSize="20sp"
            android:fontFamily="@font/alata"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/logoitemlaporan"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="12dp"/>

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="20.000"
            android:id="@+id/tvHargaProduk"
            android:textSize="20sp"
            android:fontFamily="@font/alata"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/logoitemlaporan"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="12dp"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAktif"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Dikerjakan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="20sp"
            app:chipIcon="@drawable/lingkaran_dikerjakan"
            app:chipIconSize="10dp"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#D0D0D0"
            app:chipCornerRadius="23dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>