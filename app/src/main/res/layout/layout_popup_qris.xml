<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:id="@+id/qrQris"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvTotalHargaQris"
                android:layout_marginVertical="20dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:src="@drawable/img_17"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTotalHargaQris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="60.000"
                android:fontFamily="@font/alata"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@id/btnLanjutkan"
                app:layout_constraintStart_toStartOf="@id/btnLanjutkan"/>

            <TextView
                android:id="@+id/tvQris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="QRIS"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/alata"
                app:layout_constraintEnd_toEndOf="@id/btnLanjutkan"
                app:layout_constraintBottom_toTopOf="@id/btnLanjutkan"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:id="@+id/btnLanjutkan"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="Lanjutkan"
                android:layout_marginHorizontal="15dp"
                android:backgroundTint="#FFB200"
                android:textColor="@color/white"
                app:cornerRadius="23dp"
                android:layout_margin="15dp"
                android:fontFamily="@font/alata"
                android:textSize="20sp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>