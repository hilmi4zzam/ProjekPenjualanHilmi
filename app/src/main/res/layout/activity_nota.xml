<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp"
        tools:context=".transaksi.Nota">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembayaran Berhasil"
            android:id="@+id/tvPembayaranBerhasil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/alata"
            android:textStyle="bold"
            android:textSize="33sp"
            android:layout_marginTop="80dp"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@color/black"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvNota"
            app:strokeColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="30dp"
            app:cardCornerRadius="23dp"
            app:layout_constraintTop_toBottomOf="@id/tvPembayaranBerhasil"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="30dp"
            android:textColorHint="@color/black">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/background"
                android:padding="15dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Pemesan : "
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/alata"/>

                    <TextView
                        android:id="@+id/tvNama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Hilmi"
                        android:layout_alignParentEnd="true"
                        android:textSize="20sp"
                        android:fontFamily="@font/alata"/>

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginVertical="10dp"/>

                <LinearLayout
                    android:id="@+id/llItemSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Items dynamically added here -->
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginVertical="10dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total : "
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/alata"/>

                    <TextView
                        android:id="@+id/tvTotalHarga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60.000"
                        android:textColor="@color/black"
                        android:layout_alignParentEnd="true"
                        android:textSize="20sp"
                        android:fontFamily="@font/alata"/>

                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:text="Cetak"
            android:id="@+id/btnCetak"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvNota"
            app:layout_constraintEnd_toStartOf="@id/btnBagikan"
            android:backgroundTint="#B06710"
            android:fontFamily="@font/alata"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="30dp"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:text="Bagikan"
            android:textColor="#FFFFFF"
            android:id="@+id/btnBagikan"
            app:layout_constraintTop_toBottomOf="@id/cvNota"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@id/btnCetak"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="#B06710"
            android:fontFamily="@font/alata"
            android:layout_marginTop="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="30dp"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Selesai"
            android:id="@+id/btnSelesai"
            app:layout_constraintTop_toBottomOf="@id/btnCetak"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="#FFB200"
            android:fontFamily="@font/alata"
            android:layout_marginTop="7dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
