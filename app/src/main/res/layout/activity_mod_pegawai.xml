<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".pegawai.ModPegawai">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Pegawai"
            android:id="@+id/tvTambahPegawai"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/alata"
            android:textStyle="bold"
            android:textSize="40sp"
            android:layout_marginTop="80dp"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@color/black"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilModPegawaiNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="30dp"
            app:boxCornerRadiusBottomEnd="23dp"
            app:boxCornerRadiusTopStart="23dp"
            app:boxCornerRadiusBottomStart="23dp"
            app:boxCornerRadiusTopEnd="23dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="30dp"
            android:textColorHint="@color/black"
            app:layout_constraintTop_toBottomOf="@id/tvTambahPegawai"
            android:hint="Nama Pegawai">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:id="@+id/tietNamaPegawai"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alata"
                android:textSize="20sp"
                android:textColor="@color/black"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilModPegawaiStatus"
            android:layout_width="match_parent"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            app:boxCornerRadiusBottomEnd="23dp"
            app:boxCornerRadiusTopStart="23dp"
            app:boxCornerRadiusBottomStart="23dp"
            app:boxCornerRadiusTopEnd="23dp"
            android:layout_marginEnd="30dp"
            android:textColorHint="@color/black"
            app:layout_constraintTop_toBottomOf="@id/tilModPegawaiNama"
            android:hint="Status">

            <AutoCompleteTextView
                android:id="@+id/spModPegawaiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:labelFor="@id/spModPegawaiStatus"
                android:fontFamily="@font/alata"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:entries="@array/statusKategori"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Simpan"
            android:backgroundTint="#FFB200"
            android:textColor="#FFFFFF"
            android:id="@+id/btnModPegawaiSimpan"
            app:layout_constraintTop_toBottomOf="@id/tilModPegawaiStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="30dp"
            app:cornerRadius="23dp"
            android:fontFamily="@font/alata"
            android:textSize="20sp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
